# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_doc_db?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
APP_URL="http://localhost:5173"

# Authentication Secrets (Development Defaults - Replace in Production!)
JWT_ACCESS_SECRET="dev-jwt-access-secret-32-chars-minimum-key-aoa77-doc-app"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-32-chars-minimum-key-aoa77-doc-app"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Storage Configuration
# Values: "local" | "s3"
STORAGE_TYPE="local"
STORAGE_LOCAL_ROOT="./storage/secure-uploads"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Document & Financial Defaults
DEFAULT_CURRENCY="NGN"
DEFAULT_VAT_RATE="7.5"
