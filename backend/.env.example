# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:replace-with-db-password@ep-example.eu-central-1.aws.neon.tech:5432/business_doc_db?schema=public&sslmode=require&connection_limit=20&pool_timeout=30"
DATABASE_READ_REPLICA_URL="postgresql://user:replace-with-db-password@ep-example.eu-central-1.aws.neon.tech:5432/business_doc_db?schema=public&sslmode=require&connection_limit=30&pool_timeout=30"
DB_PRIMARY_CONNECTION_LIMIT=20
DB_REPLICA_CONNECTION_LIMIT=30
DB_POOL_TIMEOUT=30
DB_READ_AFTER_WRITE_WINDOW_MS=2000

# Redis Caching & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Application Settings
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Email & SMTP Configuration (Nodemailer)
# For Gmail: Use an App Password generated at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="security@aoa77.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="AOA 77 Security <no-reply@aoa77.com>"

# Authentication Secrets (Development Defaults - Replace in Production!)
JWT_ACCESS_SECRET="dev-jwt-access-secret-32-chars-minimum-key-aoa77-doc-app"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-32-chars-minimum-key-aoa77-doc-app"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Storage Configuration
# Values: "local" | "s3"
STORAGE_TYPE="local"
STORAGE_LOCAL_ROOT="./storage/secure-uploads"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Document & Financial Defaults
DEFAULT_CURRENCY="NGN"
DEFAULT_VAT_RATE="7.5"

# Multi-Currency & External Exchange Rates
EXCHANGE_RATE_API_KEY=""

# Observability & Error Tracking
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
